{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=bookify;Username=bookify;Password=YourStrongPass123",
    "Redis": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "http://localhost:18080/realms/bookify",
    "AdminUrl": "http://localhost:18080/admin/realms/bookify/",
    "TokenUrl": "http://localhost:18080/realms/bookify/protocol/openid-connect/token",
    "ClientSecret": "PUT_YOUR_CLIENT_SECRET_HERE"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}